<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incluir Apólice - Intracor</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/apolices.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <div class="main-wrapper">
        <%- include('partials/header') %>

        <nav class="main-nav">
            <ul>
                <li><a href="/clientes"><i class="fa-solid fa-users"></i> Clientes</a></li>
                <li class="active"><a href="/apolices"><i class="fa-solid fa-file-invoice"></i> Apólices</a></li>
                <li><a href="/endossos"><i class="fa-solid fa-file-pen"></i> Endossos</a></li>
            </ul>
            <div class="quoteflex-logo-nav" style="background-color: #01212B;">
                <img src="/img/LogoQuoteFlexBranco.png" alt="QuoteFlex Logo">
            </div>
        </nav>

        <main class="content-area">
            <div class="form-container">
                <h1>Incluir Nova Apólice</h1>
                
                <form id="form-apolice" action="/apolices/salvar" method="POST" enctype="multipart/form-data">
                    <div class="form-grid">
                        <!-- Dados Básicos -->
                        <div class="form-section">
                            <h3>Dados Básicos</h3>
                            
                            <div class="form-group">
                                <label for="cliente">Cliente *</label>
                                <select id="cliente" name="cliente" required>
                                    <option value="">Selecione um cliente</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="nApolice">Número da Apólice *</label>
                                <input type="text" id="nApolice" maxlength="16"   name="nApolice" required>
                            </div>

                            <div class="form-group">
                                <label for="tipoApolice">Tipo de Apólice *</label>
                                <select id="tipoApolice" name="tipoApoliceId" required>
                                    <option value="">Selecione o tipo</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="ramoApolice">Ramo *</label>
                                <select id="ramoApolice" name="ramoId" required>
                                    <option value="">Selecione o ramo</option>
                                </select>
                            </div>
                        </div>

                        <!-- Valores e Pagamento -->
                        <div class="form-section">
                            <h3>Valores e Pagamento</h3>
                            
                            <div class="form-group">
                                <label for="premioTotal">Prêmio Total *</label>
                                <input type="text" id="premioTotal" name="premioTotal" placeholder="R$ 0,00" required>
                            </div>

                            <div class="form-group">
                                <label for="parcelas">Parcelas *</label>
                                <input type="text" id="parcelas" name="parcelas" placeholder="Ex: 12x" required>
                            </div>

                            <div class="form-group">
                                <label for="tipoPagamento">Forma de Pagamento *</label>
                                <select id="tipoPagamento" name="formaPagamentoId" required>
                                    <option value="">Selecione a forma</option>
                                </select>
                            </div>
                        </div>

                        <!-- Vigência -->
                        <div class="form-section">
                            <h3>Vigência</h3>
                            
                            <div class="form-group">
                                <label for="vigenciaInicio">Início da Vigência *</label>
                                <input type="date" id="vigenciaInicio" name="vigenciaInicio" required>
                            </div>

                            <div class="form-group">
                                <label for="vigenciaFinal">Fim da Vigência *</label>
                                <input type="date" id="vigenciaFinal" name="vigenciaFinal" required>
                            </div>
                        </div>

                        <!-- Anexos -->
                        <div class="form-section">
                            <h3>Anexos</h3>
                            
                            <div class="form-group">
                                <label for="anexo">Anexar Documento</label>
                                <input type="file" id="anexo" name="anexo" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                <small>Formatos aceitos: PDF, JPG, PNG, DOC (Max: 10MB)</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="window.history.back()">Cancelar</button>
                        <button type="submit" class="btn-primary">Salvar Apólice</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            carregarClientes();
            carregarTiposApolice();
            carregarRamosApolice();
            carregarTiposPagamento();

            // Máscara para prêmio
            const premioInput = document.getElementById('premioTotal');
            premioInput.addEventListener('input', formatarMoeda);

            // Captura o ID da apólice pela URL
            const urlParts = window.location.pathname.split('/');
            const apoliceId = urlParts[urlParts.length - 1];

            if (apoliceId && apoliceId !== 'incluir') {
                carregarDadosApolice(apoliceId);
                document.querySelector('h1').textContent = 'Alterar Apólice';
            }
        });

        // --- Função para formatar moeda ---
        function formatarMoeda(event) {
            let value = event.target.value.replace(/\D/g, '');
            value = (value / 100).toFixed(2) + '';
            value = value.replace('.', ',');
            value = value.replace(/(\d)(\d{3})(\d{3}),/g, '$1.$2.$3,');
            value = value.replace(/(\d)(\d{3}),/g, '$1.$2,');
            event.target.value = 'R$ ' + value;
        }

        // --- Funções para carregar selects ---
        async function carregarClientes() {
            try {
                const response = await fetch('/clientes/getClientes');
                const data = await response.json();
                const select = document.getElementById('cliente');

                if (data.success && data.clientes) {
                    select.innerHTML = '<option value="">Selecione um cliente</option>';
                    data.clientes.forEach(cliente => {
                        const option = document.createElement('option');
                        option.value = cliente.cliente_id;
                        option.textContent = cliente.nome;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Erro ao carregar clientes:', error);
            }
        }

        async function carregarTiposApolice() {
            try {
                const response = await fetch('/apolices/getTiposApolice');
                const data = await response.json();
                const select = document.getElementById('tipoApolice');

                if (data.success && data.tipos) {
                    select.innerHTML = '<option value="">Selecione o tipo</option>';
                    data.tipos.forEach(tipo => {
                        const option = document.createElement('option');
                        option.value = tipo.tpapolice_id;
                        option.textContent = tipo.descricao;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Erro ao carregar tipos de apólice:', error);
            }
        }

        async function carregarRamosApolice() {
            try {
                const response = await fetch('/apolices/getRamosApolice');
                const data = await response.json();
                const select = document.getElementById('ramoApolice');

                if (data.success && data.ramos) {
                    select.innerHTML = '<option value="">Selecione o ramo</option>';
                    data.ramos.forEach(ramo => {
                        const option = document.createElement('option');
                        option.value = ramo.ramoapolic_id;
                        option.textContent = ramo.descricao;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Erro ao carregar ramos de apólice:', error);
            }
        }

        async function carregarTiposPagamento() {
            try {
                const response = await fetch('/apolices/getTiposPagamento');
                const data = await response.json();
                const select = document.getElementById('tipoPagamento');

                if (data.success && data.tiposPagamento) {
                    select.innerHTML = '<option value="">Selecione a forma</option>';
                    data.tiposPagamento.forEach(tipo => {
                        const option = document.createElement('option');
                        option.value = tipo.tppag_id;
                        option.textContent = tipo.descricao;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Erro ao carregar tipos de pagamento:', error);
            }
        }

        // --- Função para carregar dados de uma apólice ---
        async function carregarDadosApolice(apoliceId) {
            try {
                const response = await fetch(`/apolices/getApolice/${apoliceId}`);
                const data = await response.json();

                if (data.success && data.apolice) {
                    preencherFormularioApolice(data.apolice);
                } else {
                    console.error('Erro ao carregar dados da apólice:', data.error);
                }
            } catch (error) {
                console.error('Erro na requisição:', error);
            }
        }

        // --- Função para preencher formulário ---
        async function preencherFormularioApolice(apolice) {
            document.getElementById('cliente').value = apolice.cliente_id || '';
            document.getElementById('nApolice').value = apolice.nro || '';
            document.getElementById('premioTotal').value = apolice.premio ? 'R$ ' + apolice.premio.toFixed(2).replace('.', ',') : '';
            document.getElementById('parcelas').value = apolice.parcelas || '';
            document.getElementById('vigenciaInicio').value = apolice.vigenciaInicio || '';
            document.getElementById('vigenciaFinal').value = apolice.vigenciaFinal || '';

            await Promise.all([
                carregarClientes().then(() => { document.getElementById('cliente').value = apolice.cliente_id || ''; }),
                carregarTiposApolice().then(() => { document.getElementById('tipoApolice').value = apolice.tipoApoliceId || ''; }),
                carregarRamosApolice().then(() => { document.getElementById('ramoApolice').value = apolice.ramoId || ''; }),
                carregarTiposPagamento().then(() => { document.getElementById('tipoPagamento').value = apolice.formaPagamentoId || ''; })
            ]);
        }

        document.querySelector('.btn-primary').addEventListener('click', async function(e) {
            e.preventDefault();

            const urlParts = window.location.pathname.split('/');
            const apoliceId = urlParts[urlParts.length - 1];

            // Campos do formulário
            const cliente = document.getElementById('cliente').value;
            const nApolice = document.getElementById('nApolice').value;
            const tipoApoliceId = document.getElementById('tipoApolice').value;
            const ramoId = document.getElementById('ramoApolice').value;
            const formaPagamentoId = document.getElementById('tipoPagamento').value;
            const vigenciaInicio = document.getElementById('vigenciaInicio').value;
            const vigenciaFinal = document.getElementById('vigenciaFinal').value;

            // Formata prêmio e parcelas - CORREÇÃO AQUI
            const premioTotalRaw = document.getElementById('premioTotal').value;
            const premioFormatado = premioTotalRaw ? 
                parseFloat(premioTotalRaw.replace('R$', '').replace(/\./g, '').replace(',', '.')) : null;

            const parcelasRaw = document.getElementById('parcelas').value;
            const parcelasFormatado = parcelasRaw ? 
                parseInt(parcelasRaw.replace(/\D/g, '')) : null;

            // Validações básicas
            if (!cliente) { alert('Selecione um cliente'); return; }
            if (!nApolice) { alert('Informe o número da apólice'); return; }
            if (!tipoApoliceId) { alert('Selecione o tipo de apólice'); return; }
            if (!ramoId) { alert('Selecione o ramo'); return; }
            if (premioFormatado === null || isNaN(premioFormatado)) { alert('Informe um prêmio válido'); return; }
            if (parcelasFormatado === null || isNaN(parcelasFormatado)) { alert('Informe o número de parcelas'); return; }
            if (!formaPagamentoId) { alert('Selecione a forma de pagamento'); return; }
            if (!vigenciaInicio) { alert('Informe a data de início da vigência'); return; }
            if (!vigenciaFinal) { alert('Informe a data final da vigência'); return; }

            try {
                const formData = new FormData();
                formData.append('cliente', cliente);
                formData.append('nApolice', nApolice);
                formData.append('tipoApoliceId', tipoApoliceId); // CORRETO
                formData.append('ramoId', ramoId);
                formData.append('premioTotal', premioFormatado); // JÁ FORMATADO
                formData.append('parcelas', parcelasFormatado); // JÁ FORMATADO
                formData.append('formaPagamentoId', formaPagamentoId);
                formData.append('vigenciaInicio', vigenciaInicio);
                formData.append('vigenciaFinal', vigenciaFinal);
                
                if (apoliceId && apoliceId !== 'incluir') {
                    formData.append('apoliceId', apoliceId);
                }

                // Anexo
                const anexo = document.getElementById('anexo').files[0];
                if (anexo) formData.append('anexo', anexo);

                console.log('Enviando dados:', {
                    cliente, nApolice, tipoApoliceId, ramoId, premioFormatado, 
                    parcelasFormatado, formaPagamentoId, vigenciaInicio, vigenciaFinal, apoliceId
                });

                const response = await fetch('/apolices/salvar', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    alert(apoliceId && apoliceId !== 'incluir' ? 'Apólice alterada com sucesso!' : 'Apólice salva com sucesso!');
                    window.location.href = '/apolices';
                } else {
                    alert('Erro ao salvar apólice: ' + (result.message || 'Erro desconhecido'));
                }

            } catch (error) {
                console.error('Erro:', error);
                alert('Erro ao salvar apólice: ' + error.message);
            }
        });
    </script>
</body>
</html>